<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>

    <!-- Roslyn analyzers: catch real bugs and style issues at build time. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Single source of truth for the CLI's reported version (see the "version"
         flag) and release binary naming. Bump alongside CHANGELOG.md. -->
    <Version>0.1.0</Version>

    <!-- Shared package metadata for anything published to NuGet later. -->
    <Authors>Agentic Project Architect contributors</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/juanfarcik/agent-project-architect</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
